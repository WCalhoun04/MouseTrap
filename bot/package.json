{
  "name": "mousetrap-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "test-mode": "tsx src/cli.ts test",
    "demo": "tsx src/cli.ts demo",
    "live": "tsx src/cli.ts live",
    "localnet": "solana-test-validator --reset --quiet --ledger .localnet/ledger --bpf-program 2rhxbbbqDtRPfGDAcd4LK7iqbR6Ro58R3QLs1NG9EZfd ../escrow/target/deploy/mousetrap_vault.so",
    "localnet:setup": "tsx scripts/localnet-setup.ts",
    "idl:sync": "cp ../escrow/target/idl/mousetrap_vault.json ../escrow/target/types/mousetrap_vault.ts src/vault/idl/ && cp ../escrow/target/idl/mousetrap_vault.json ../web/src/lib/idl/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@gemini-markets/sdk": "^0.1.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "dotenv": "^18.0.10",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
