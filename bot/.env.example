# Test mode needs none of these. Copy to .env to change defaults.

# test mode
PORT=8787
# Read-only market maker dashboard for demos
DASHBOARD_PORT=8788
WEB_ORIGIN=http://localhost:3000
EPOCH_SECONDS=60
MAX_CONTRACTS=8
# Replay one day of each contract's real Gemini volume inside every epoch, so PnL per
# epoch approximates PnL per real day. "off" fills only on real trades. on | off
DAY_FLOW=on
# Assumptions behind the replay: share of taker flow that reaches the bot, share of
# takers who are informed, and what an informed fill costs in cents per contract.
CAPTURE_SHARE=0.5
INFORMED_SHARE=0.3
INFORMED_MOVE_CENTS=2

# chain mode (--chain): the validator running the escrow program
SOLANA_RPC_URL=http://127.0.0.1:8899

# demo (Gemini sandbox) and live
GEMINI_API_KEY=
GEMINI_API_SECRET=
# Match the "time-based nonce" checkbox on the key: time-based | monotonic
GEMINI_NONCE=time-based

# live only: both must be set
MODE=
I_UNDERSTAND_LIVE_TRADING=
